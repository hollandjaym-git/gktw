# Local standalone stack (docker-compose.yml)
POSTGRES_DB=gktw
POSTGRES_USER=gktw
POSTGRES_PASSWORD=gktw_local
TZ=America/Chicago

# Production (docker-compose.prod.yml, pg-shared) — set the real secret here.
# PGSHARED_GKTW_PASSWORD=

# Optional: baked into the build as the version marker (usually the git sha).
# SOURCE_COMMIT=
